# Zoho Mail SMTP — contact form delivery (src/app/contact/actions.ts)
ZOHO_SMTP_USER=info@accendoraconsulting.com
# Zoho app-specific password (Zoho Mail > Settings > Security > App Passwords)
ZOHO_SMTP_PASS=
# smtp.zoho.eu for EU/UK-region accounts, smtp.zoho.com for US, smtp.zoho.in for India
ZOHO_SMTP_HOST=smtp.zoho.eu
# Optional: inbox that receives enquiries (defaults to site.email)
CONTACT_TO=
